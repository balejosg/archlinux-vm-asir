Documentation=https://github.com/balejosg/archlinux-vm-asir
After=network.target

[Service]
Type=oneshot
User=root
ExecStart=/home/alumno/trabajo/plantillas-sostenibilidad/03-auto-power-management/eco-power-manager.sh
